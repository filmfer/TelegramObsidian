# --- Telegram ---
TELEGRAM_BOT_TOKEN=xxxx:your_bot_token_here

# Chat ID for proactive alerts (weekly model checks).
# Get it by messaging the bot, then: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- Gemini / LLM providers (set the ones you use; all optional except one) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
# GROQ_API_KEY=            # free tier: llama-3.3-70b + Whisper (audio, Phase B)
# OPENROUTER_API_KEY=      # free models with :free suffix (DeepSeek, Qwen, Llama)
# ZHIPU_API_KEY=           # FREE Chinese API: GLM-4-Flash (very generous free tier)
# OLLAMA_HOST=             # e.g. http://localhost:11434 for local, unlimited & private

# Preferred model (litellm format). The bot auto-detects availability,
# auto-switches on failure, and lets you pick via /models in Telegram.
#
# ⚙️ TIP — passo o Gemini Excedido em cota? Coloca o primário num modelo GRÁTIS:
#   LLM_MODEL=openrouter/deepseek/deepseek-chat:free     (OpenRouter free)
#   LLM_MODEL=zhipu/glm-4-flash                          (Zhipu/China grátis)
# O bot salta automaticamente para um fallback válido quando o primário
# falha, e persiste a troca (já não volta a tentar o modelo esgotado).
LLM_MODEL=gemini/gemini-flash-latest
# Fallbacks ordered by priority. The :free OpenRouter/DeepSeek & Zhipu GLM
# entries are zero-cost and reset daily — great escapes from quota limits.
LLM_FALLBACKS=groq/openai/gpt-oss-120b,groq/llama-3.1-8b-instant,openrouter/deepseek/deepseek-chat:free,zhipu/glm-4-flash,gemini/gemini-pro-latest

# --- FREE / QUASI-UNLIMITED options (pick one) ---
# 1) OpenRouter FREE tier —  many models, ":free" suffix, daily per-model limit.
#    40+ :free models: deepseek/deepseek-chat:free, qwen/qwen-2.5-72b-instruct:free,
#    meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free ...
#    Get a key: https://openrouter.ai/keys   (no billing needed for :free)
#
# 2) Zhipu (China) GLM-4-Flash — 100% FREE official API, very generous daily quota.
#    Get a key: https://open.bigmodel.cn/  → API Key (free plan includes glm-4-flash)
#    litellm model name:  zhipu/glm-4-flash
#
# 3) SiliconFlow (China, OpenAI-compatible) — free DeepSeek-V3 / Qwen2.5 / GLM-4-Flash.
#    Needs custom base URL; ask here if you want me to wire it (`siliconflow`).
#
# 4) Ollama LOCAL — truly unlimited, private, zero cost, runs on your own VPS.
#    Server-side:  curl -fsSL https://ollama.com/install.sh | sh
#                  ollama pull qwen2.5:7b      # ~4.7GB, runs on CPU
#                  (then OLLAMA_HOST=http://127.0.0.1:11434 and add
#                   ollama/qwen2.5:7b to LLM_FALLBACKS — no API key needed)

# --- YouTube / video ---
# Captions fallback chain: youtube-transcript-api -> yt-dlp subtitles -> audio.
# Optional outbound proxy for YouTube (if the VPS IP is throttled).
# YOUTUBE_PROXY_URL=socks5://user:pass@host:port
# Local Whisper model used as last-resort transcription for long videos:
#   tiny | base | small | medium  (bigger = more accurate, slower on CPU)
WHISPER_MODEL=base

# --- Obsidian Vault ---
# Inside the container (do not change)
OBSIDIAN_VAULT_PATH=/data/vault

# On the Ubuntu host: full path to the folder that contains the vault.
# This is where rclone mounts Google Drive OR a synced folder.
# Used by docker-compose to bind-mount the vault into the container.
OBSIDIAN_VAULT_HOST_PATH=/srv/obsidian-vault

# --- Dedup store ---
# SQLite DB for duplicate detection + /text //voice pending queue.
# Lives OUTSIDE the vault on purpose. Persist it via the agent-data
# docker volume (already wired in docker-compose.yml).
# DEDUP_DB_PATH=data/agent.db

# --- Pending queue (/text, /voice) ---
# Queued items older than this are dropped automatically.
PENDING_QUEUE_TTL_HOURS=24
# TASK_TIMEOUT_SECONDS=600   # hard cap per task (default 10 min)
# TASK_WARN_SECONDS=100      # 'still working' checkpoint

# --- Disk-space alerts ---
DISK_WARN_THRESHOLD_PCT=20   # proactive warning threshold
DISK_ALERT_MINUTES=60        # anti-spam cooldown between proactive alerts
