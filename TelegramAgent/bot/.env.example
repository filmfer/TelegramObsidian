# --- Telegram ---
TELEGRAM_BOT_TOKEN=xxxx:your_bot_token_here

# Chat ID for proactive alerts (weekly model checks).
# Get it by messaging the bot, then: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- Gemini / LLM providers (set the ones you use; all optional except one) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
# GROQ_API_KEY=            # free tier: llama-3.3-70b + Whisper (audio, Phase B)
# OPENROUTER_API_KEY=      # free models with :free suffix
# OLLAMA_HOST=             # e.g. http://localhost:11434 for local models

# Preferred model (litellm format). The bot auto-detects availability,
# auto-switches on failure, and lets you pick via /models in Telegram.
LLM_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACKS=groq/llama-3.3-70b-versatile,gemini/gemini-2.0-flash

# --- Obsidian Vault ---
# Inside the container (do not change)
OBSIDIAN_VAULT_PATH=/data/vault

# On the Ubuntu host: full path to the folder that contains the vault.
# This is where rclone mounts Google Drive OR a synced folder.
# Used by docker-compose to bind-mount the vault into the container.
OBSIDIAN_VAULT_HOST_PATH=/srv/obsidian-vault
